{
  "name": "tabwright",
  "description": "Understand and debug live web applications with browser, network, source, and runtime evidence.",
  "version": "3.5.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuyang-Hou/Tabwright.git"
  },
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && mkdir dist && bun scripts/build-client-bundles.ts && tsc -p tsconfig-build.json && bun scripts/build-extension-bundle.ts && bun scripts/build-resources.ts",
    "postinstall": "node postinstall.js",
    "prepublishOnly": "pnpm build",
    "watch": "tsc -w",
    "cli": "vite-node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "mcp": "vite-node src/mcp.ts",
    "test": "vitest run --no-file-parallelism",
    "test:unit": "vitest run src/executor.unit.test.ts src/network-inspector.test.ts src/cdp-resources.test.ts src/cdp-log.test.ts src/editor.test.ts src/wakaru.test.ts src/documentation.test.ts src/cli-help.test.ts src/skill-stub.test.ts src/tabwright-agent-skill.test.ts src/relay-state.test.ts src/protocol.test.ts src/retired-features.test.ts src/doctor.test.ts src/scoped-fs.test.ts",
    "test:acceptance": "vitest run src/agent-debugging.test.ts src/cdp-resources.browser.test.ts --no-file-parallelism",
    "test:watch": "vitest"
  },
  "bin": {
    "tabwright": "bin.js",
    "playwriter": "bin.js"
  },
  "files": [
    "dist",
    "src/skill.md",
    "bin.js",
    "postinstall.js",
    "readme.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "browser-automation",
    "chrome",
    "mcp",
    "playwright",
    "ai-agent",
    "agent-skills",
    "browser-debugging"
  ],
  "author": "Yuyang Hou",
  "license": "Apache-2.0",
  "devDependencies": {
    "@browserbasehq/stagehand": "^3.0.5",
    "@mizchi/selector-generator": "1.50.0-next",
    "@mozilla/readability": "^0.6.0",
    "@types/chrome": "^0.0.315",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "@vitest/ui": "^4.0.8",
    "bippy": "^0.5.27",
    "devtools-protocol": "^0.0.1568893",
    "image-size": "^2.0.2",
    "kitty-graphics-agent": "^0.0.5",
    "marked": "^17.0.1",
    "mcp-extension": "workspace:^",
    "vite-node": "^5.0.0",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@hono/node-ws": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@wakaru/cli": "1.10.0",
    "@xmorse/playwright-core": "workspace:^",
    "acorn": "^8.15.0",
    "async-sema": "^3.1.1",
    "diff": "^8.0.2",
    "dom-accessibility-api": "^0.7.1",
    "goke": "^6.12.1",
    "hono": "^4.12.12",
    "picocolors": "^1.1.1",
    "posthtml": "^0.16.7",
    "posthtml-beautify": "^0.7.0",
    "string-dedent": "^3.0.2",
    "strip-ansi": "^7.1.2",
    "ws": "^8.18.3",
    "zod": "^4.3.5",
    "zustand": "^5.0.8"
  },
  "optionalDependencies": {
    "@playwriter/patchright-core": "^1.61.0-playwriter.1",
    "sharp": "^0.34.5"
  }
}
