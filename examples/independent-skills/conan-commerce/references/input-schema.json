{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "user.query",
        "group.query",
        "group.detail",
        "group.validate",
        "coupon-template.query",
        "coupon.query",
        "legacy-product.query",
        "legacy-product.detail",
        "product.query",
        "product.detail",
        "order.query",
        "order.detail",
        "legacy-price-strategy.query",
        "legacy-price-strategy.detail",
        "price-strategy.query",
        "price-strategy.detail"
      ]
    },
    "environment": {
      "type": "string",
      "enum": ["cn-prod", "cn-test"],
      "description": "查询环境，默认 cn-prod；cn-test 使用 ytkconan。"
    },
    "query": {
      "type": ["string", "integer"],
      "description": "用户、优惠券等动作的快捷关键词"
    },
    "id": {
      "type": ["string", "integer"],
      "description": "单个详情 ID"
    },
    "ids": {
      "type": "array",
      "items": {
        "type": ["string", "integer"]
      },
      "description": "通用 ID 列表"
    },
    "groupIds": {
      "type": "array",
      "items": {
        "type": ["string", "integer"]
      },
      "description": "群组 ID 列表"
    },
    "userIds": {
      "type": "array",
      "items": {
        "type": ["string", "integer"]
      },
      "description": "群组验证或业务查询中的 User ID 列表"
    },
    "filters": {
      "type": "object",
      "description": "对应管理页面支持的筛选条件；脚本会按 action 白名单过滤"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "最多返回条数，默认 20"
    },
    "includeRaw": {
      "type": "boolean",
      "description": "是否附带原始接口对象；默认 false"
    }
  },
  "required": ["action"],
  "additionalProperties": false
}
