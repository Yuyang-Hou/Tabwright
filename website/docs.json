{
  "$schema": "https://holocron.so/docs.json",
  "name": "Tabwright",
  "description": "Browser debugging and automation tools for AI agents, built on Playwriter.",
  "logo": {
    "light": "/logo-square.svg",
    "dark": "/logo-square.svg",
    "href": "/"
  },
  "favicon": {
    "light": "/favicon-32.png",
    "dark": "/favicon-32.png"
  },
  "colors": {
    "primary": "#FF9500",
    "light": "#FF9500",
    "dark": "#FF9500"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "lucide:book",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "lucide:rocket",
            "pages": [
              "index",
              "docs/installation",
              "docs/cli",
              "docs/mcp-setup"
            ]
          },
          {
            "group": "Guides",
            "icon": "lucide:book-open",
            "pages": [
              "docs/independent-scripts",
              "docs/remote-access",
              "docs/troubleshooting"
            ]
          },
          {
            "group": "Use Cases",
            "icon": "lucide:lightbulb",
            "pages": [
              "docs/use-cases"
            ]
          },
          {
            "group": "Reference",
            "icon": "lucide:book-text",
            "pages": [
              "docs/skill"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/Yuyang-Hou/tabwright",
          "placement": "tabs"
        },
        {
          "anchor": "Changelog",
          "icon": "lucide:logs",
          "href": "https://github.com/Yuyang-Hou/tabwright/releases",
          "placement": "tabs"
        }
      ]
    }
  },
  "navbar": {
    "primary": {
      "label": "Get started",
      "href": "/docs/installation"
    }
  },
  "footer": {
    "links": [
      {
        "header": "platform",
        "items": [
          {
            "label": "Installation",
            "href": "/docs/installation"
          },
          {
            "label": "GitHub",
            "href": "https://github.com/Yuyang-Hou/tabwright"
          },
          {
            "label": "Chrome Extension",
            "href": "https://chromewebstore.google.com/detail/tabwright/dkfhphbajbkplddmchbdgdddioonngep"
          }
        ]
      }
    ],
    "socials": {
      "github": "https://github.com/Yuyang-Hou/tabwright"
    }
  },
  "assistant": {
    "enabled": false
  }
}
